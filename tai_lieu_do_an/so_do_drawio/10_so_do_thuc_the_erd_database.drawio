" width="170" height="85" as="geometry"/></mxCell><mxCell id="e_attr" value="&lt;b&gt;ATTR_TOURS&lt;/b&gt;&#xa;--------------------------&#xa;+ PK id: bigint&#xa;+ name: varchar (transport/type)&#xa;+ value: varchar" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#faf8f5;strokeColor=#b85e3a;strokeWidth=1.5;rounded=1;align=left;spacingLeft=8;fontFamily=Consolas,monospace;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="180" height="85" as="geometry"/></mxCell><mxCell id="e_tattr" value="&lt;b&gt;TOUR_ATTR&lt;/b&gt;&#xa;--------------------------&#xa;+ FK tour_id: bigint&#xa;+ FK attr_tour_id: bigint" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#faf8f5;strokeColor=#b85e3a;strokeWidth=1.5;rounded=1;align=left;spacingLeft=8;fontFamily=Consolas,monospace;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="230" width="180" height="75" as="geometry"/></mxCell><mxCell id="e_order" value="&lt;b&gt;ORDERS&lt;/b&gt;&#xa;--------------------------&#xa;+ PK id: bigint&#xa;+ FK user_id: bigint&#xa;+ FK tour_id: bigint&#xa;+ name, phone, email: str&#xa;+ total_price: bigint&#xa;+ quantity: int&#xa;+ status: tinyint (0-5)" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#fed7aa;strokeColor=#863c20;strokeWidth=1.5;rounded=1;align=left;spacingLeft=8;fontFamily=Consolas,monospace;fontSize=10;" vertex="1" parent="1"><mxGeometry x="550" y="230" width="200" height="145" as="geometry"/></mxCell><mxCell id="e_user" value="&lt;b&gt;USERS&lt;/b&gt;&#xa;--------------------------&#xa;+ PK id: bigint&#xa;+ name, email: str&#xa;+ password: str&#xa;+ phone, address: str&#xa;+ role: enum(user,admin)&#xa;+ status: str" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;rounded=1;align=left;spacingLeft=8;fontFamily=Consolas,monospace;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="230" width="180" height="135" as="geometry"/></mxCell><mxCell id="e_pay" value="&lt;b&gt;PAYMENTS&lt;/b&gt;&#xa;------------