ry"><mxPoint x="865" y="320" as="sourcePoint"/><mxPoint x="490" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7" value="Fallback: (Nếu AI lỗi) SQL LIKE & bóc tách từ khóa" style="html=1;verticalAlign=bottom;endArrow=block;endSize=7;dashed=0;rounded=0;strokeColor=#863c20;strokeWidth=1.5;fontSize=10.5;" edge="1" parent="1"><mxGeometry x="0" y="10" relative="1" as="geometry"><mxPoint x="490" y="360" as="sourcePoint"/><mxPoint x="685" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m8" value="7. saveBotMessage(session_id, reply)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=7;dashed=0;rounded=0;strokeColor=#1e293b;strokeWidth=1.5;fontSize=10.5;" edge="1" parent="1"><mxGeometry x="0" y="10" relative="1" as="geometry"><mxPoint x="490" y="400" as="sourcePoint"/><mxPoint x="685" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m9" value="8. JSON Response { status: success, reply }" style="html=1;verticalAlign=bottom;endArrow=open;endSize=7;dashed=1;rounded=0;strokeColor=#1e293b;strokeWidth=1.5;fontSize=10.5;" edge="1" parent="1"><mxGeometry x="0" y="10" relative="1" as="geometry"><mxPoint x="490" y="445" as="sourcePoint"/><mxPoint x="295" y="445" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10" value="9. Parse Markdown link -> Nút bấm đất nung (btn-terracotta)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=7;dashed=0;rounded=0;strokeColor=#15803d;strokeWidth=1.5;fontSize=10.5;" edge="1" parent="1"><mxGeometry x="0" y="10" relative="1" as="geometry"><mxPoint x="295" y="485" as="sourcePoint"/><mxPoint x="295" y="485" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m11" value="10. Hiển thị tin nhắn và nút click tour trực tiếp" style="html=1;verticalAlign=bottom;endArrow=open;endSize=7;dashed=1;rounded=0;strokeColor=#1e293b;strokeWidth=1.5;fontSize=10.5;" edge="1" parent="1"><mxGeometry x="0" y="10" relative="1" as="geometry"><mxPoint x="295" y="520" as="sourcePoint"/><mxPoint x="110" y="520" as="targetP