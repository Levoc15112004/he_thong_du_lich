      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l_u" value="Khách hàng" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.5;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="50" width="90" height="680" as="geometry"/></mxCell><mxCell id="l_v" value="UI Trình duyệt" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#faf8f5;strokeColor=#b85e3a;strokeWidth=1.5;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="50" width="100" height="680" as="geometry"/></mxCell><mxCell id="l_c" value="CartController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#faf8f5;strokeColor=#b85e3a;strokeWidth=1.5;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="50" width="110" height="680" as="geometry"/></mxCell><mxCell id="l_o" value="OrderController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#faf8f5;strokeColor=#b85e3a;strokeWidth=1.5;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="50" width="115" height="680" as="geometry"/></mxCell><mxCell id="l_m" value="MomoController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fce7f3;strokeColor=#be185d;strokeWidth=1.5;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="50" width="115" height="680" as="geometry"/></mxCell><mxCell id="l_d" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fill