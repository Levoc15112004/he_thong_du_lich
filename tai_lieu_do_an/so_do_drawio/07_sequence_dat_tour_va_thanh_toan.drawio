ize=10.5;" edge="1" parent="1"><mxGeometry x="0" y="10" relative="1" as="geometry"><mxPoint x="767" y="635" as="sourcePoint"/><mxPoint x="260" y="635" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m17" value="14. Hiển thị trang hoàn tất & mã vé điện tử" style="html=1;verticalAlign=bottom;endArrow=open;endSize=7;dashed=1;rounded=0;strokeColor=#1e293b;strokeWidth=1.5;fontSize=10.5;" edge="1" parent="1"><mxGeometry x="0" y="10" relative="1" as="geometry"><mxPoint x="260" y="665" as="sourcePoint"/><mxPoint x="105" y="665" as="targetPoint"/></mxGeometry></mxCell></root>
